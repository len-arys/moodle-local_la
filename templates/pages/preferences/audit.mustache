{{!
    @template local_la/pages/preferences/audit

    Renders plugin audit log controls and results.

    Classes required for JS:
    * .alert - JavaScript selector hook.
    * .fa - JavaScript selector hook.
    * .form-control - JavaScript selector hook.

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * header - string: Text for header.
    * head - string: Text for head.
    * needsupgrade - array|bool: Section data or visibility flag for needsupgrade.
    * upgradecopy - string: Text for upgradecopy.
    * billingurl - string: URL for billingurl.
    * search - string: Text for search.
    * actions - array: List of entries for actions.
    * value - string: Text for value.
    * selected - array|bool: Section data or visibility flag for selected.
    * name - string: Text for name.
    * table - string: Rendered HTML for table.

    Example context (json):
    {
        "head": "<title>Audit logs</title>",
        "header": "<header></header>",
        "search": "",
        "table": "<table></table>",
        "actions": [
            {
                "value": "",
                "name": "All actions",
                "selected": true
            }
        ]
    }
}}
<div class="la-page-wrapper">
    {{{header}}}
    <main class="la-main la-main-center pt-4 pb-4">
        <div class="la-preferences container-fluid">
            {{{head}}}

            {{#needsupgrade}}
                <div class="alert alert-info mt-4" role="alert">
                    {{upgradecopy}}
                    <a href="{{billingurl}}">{{#str}}upgrade, local_la{{/str}}</a>
                </div>
            {{/needsupgrade}}
            {{^needsupgrade}}
            <form method="get" action="" class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-4">
                <input type="hidden" name="tab" value="audit">
                <div class="input-group mb-3 w-auto">
                    <label for="la-preferences-log-search">
                        <span class="visually-hidden">{{#str}}search, core{{/str}}</span>
                    </label>
                    <input id="la-preferences-log-search" name="log_search" type="text" class="form-control rounded-start border-end-0" placeholder="{{#str}}search, core{{/str}}" aria-label="{{#str}}search, core{{/str}}" value="{{search}}" size="28">
                    <button class="input-group-text ps-2 pe-2 bg-white border-start-0" type="submit" aria-label="{{#str}}search, core{{/str}}">
                        <i class="icon fa fa-search fa-fw" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="mb-3 w-auto">
                    <select id="la-preferences-log-action" name="log_action" class="form-select" onchange="this.form.submit()">
                        {{#actions}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/actions}}
                    </select>
                </div>
            </form>
            {{{table}}}
            {{/needsupgrade}}
        </div>
    </main>
</div>
