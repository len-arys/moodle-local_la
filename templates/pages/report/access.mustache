{{!
    @template local_la/pages/report/access

    Renders report access details and management actions.

    Classes required for JS:
    * .btn - JavaScript selector hook.
    * .fa - JavaScript selector hook.
    * .form-control - JavaScript selector hook.

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * header - string: Text for header.
    * head - string: Text for head.
    * access - array|bool: Section data or visibility flag for access.
    * reportid - int: Numeric value for reportid.
    * search - string: Text for search.
    * audienceurl - string: URL for audienceurl.
    * manageaccessurl - array|bool: Section data or visibility flag for manageaccessurl.
    * table - string: Rendered HTML for table.

    Example context (json):
    {
        "head": "<h2>Report access</h2>",
        "header": "<header></header>",
        "reportid": 1,
        "audienceurl": "#",
        "manageaccessurl": "#",
        "table": "<table></table>"
    }
}}
<div class="la-page-wrapper">
    {{{header}}}
    <main class="la-main p-1 pt-4 pb-4">
        <section class="container-fluid">
            {{{head}}}
            {{#access}}
                <div class="d-flex justify-content-between align-items-start gap-3 mt-4">
                    <form method="get" class="d-flex justify-content-start">
                        <input type="hidden" name="id" value="{{reportid}}">
                        <input type="hidden" name="tab" value="access">
                        <div class="input-group mb-3 w-auto la-search-input-group">
                            <label for="la-access-search">
                                <span class="visually-hidden">{{#str}}search, core{{/str}}</span>
                            </label>
                            <input id="la-access-search" name="access_search" type="text" class="form-control" placeholder="{{#str}}search, core{{/str}}" aria-label="{{#str}}search, core{{/str}}" value="{{search}}" size="28">
                            <button class="input-group-text bg-white" type="submit" aria-label="{{#str}}search, core{{/str}}">
                                <i class="icon fa fa-search fa-fw" aria-hidden="true"></i>
                            </button>
                        </div>
                    </form>
                    <div class="d-flex gap-2">
                        <a class="btn btn-secondary" href="{{audienceurl}}">{{#str}}manageaudience, local_la{{/str}}</a>
                        {{#manageaccessurl}}
                            <a class="btn btn-secondary" href="{{manageaccessurl}}">{{#str}}manageaccess, local_la{{/str}}</a>
                        {{/manageaccessurl}}
                    </div>
                </div>
                {{{table}}}
            {{/access}}
        </section>
    </main>
</div>
