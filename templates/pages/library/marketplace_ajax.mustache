{{!
    @template local_la/pages/library/marketplace_ajax

    Renders marketplace results loaded asynchronously.

    Classes required for JS:
    * .btn - JavaScript selector hook.
    * .row - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="delete-library-item" - JavaScript data or selector hook.
    * data-action="marketplace-app-install-review" - JavaScript data or selector hook.
    * data-action="marketplace-app-update-review" - JavaScript data or selector hook.
    * data-action="marketplace-install-review" - JavaScript data or selector hook.
    * data-action="marketplace-update-review" - JavaScript data or selector hook.
    * data-confirm-button-label - JavaScript data or selector hook.
    * data-library-action - JavaScript data or selector hook.
    * data-message - JavaScript data or selector hook.
    * data-report-key - JavaScript data or selector hook.
    * data-reportid - JavaScript data or selector hook.
    * data-title - JavaScript data or selector hook.

    Context variables required for this template:
    * items - array: List of entries for items.
    * icon_class - string: Text for icon class.
    * icon - string: Text for icon.
    * plan_class - string: Text for plan class.
    * plan_name - string: Text for plan name.
    * name - string: Text for name.
    * info - string: Text for info.
    * isadded - array|bool: Section data or visibility flag for isadded.
    * isreport - array|bool: Section data or visibility flag for isreport.
    * shortname - string: Text for shortname.
    * isapp - array|bool: Section data or visibility flag for isapp.
    * isupdatable - array|bool: Section data or visibility flag for isupdatable.
    * uninstallaction - string: URL for uninstallaction.
    * itemid - int: Numeric value for itemid.
    * uninstallmessage - string: Text for uninstallmessage.
    * has_installs - array|bool: Section data or visibility flag for has installs.
    * install_count - int: Numeric value for install count.
    * install_label - string: Text for install label.

    Example context (json):
    {
        "items": [
            {
                "itemid": 1,
                "name": "Users tracking",
                "shortname": "users_tracking",
                "isreport": true,
                "install_label": "Install"
            }
        ]
    }
}}
<div class="row g-3">
    {{#items}}
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex flex-column align-items-start gap-2">
                        <div class="d-flex align-items-start justify-content-between gap-2 flex-nowrap w-100">
                            <span class="badge {{icon_class}} p-3">
                                <i class="fa-solid fa-{{icon}} fs-6"></i>
                            </span>
                            <span class="badge {{plan_class}} flex-shrink-0">{{plan_name}}</span>
                        </div>
                        <h3 class="h5 mb-0 text-truncate w-100">{{name}}</h3>
                    </div>

                    <p class="mb-0">{{info}}</p>

                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-auto">
                        <div class="d-flex flex-wrap gap-2">
                            {{^isadded}}
                                {{#isreport}}
                                    <a href="#" class="btn btn-outline-secondary" data-action="marketplace-install-review" data-report-key="{{shortname}}" data-title="{{name}}">
                                        <i class="fa-solid fa-plus"></i>&nbsp;&nbsp;{{#str}}install, local_la{{/str}}
                                    </a>
                                {{/isreport}}
                                {{#isapp}}
                                    <a href="#" class="btn btn-outline-secondary" data-action="marketplace-app-install-review" data-report-key="{{shortname}}" data-title="{{name}}">
                                        <i class="fa-solid fa-plus"></i>&nbsp;&nbsp;{{#str}}install, local_la{{/str}}
                                    </a>
                                {{/isapp}}
                            {{/isadded}}
                            {{#isadded}}
                                {{#isupdatable}}
                                    {{#isreport}}
                                        <a href="#" class="btn btn-outline-primary" data-action="marketplace-update-review" data-report-key="{{shortname}}" data-title="{{name}}">
                                            <i class="fa-solid fa-rotate"></i>&nbsp;&nbsp;{{#str}}update, core{{/str}}
                                        </a>
                                    {{/isreport}}
                                    {{#isapp}}
                                        <a href="#" class="btn btn-outline-primary" data-action="marketplace-app-update-review" data-report-key="{{shortname}}" data-title="{{name}}">
                                            <i class="fa-solid fa-rotate"></i>&nbsp;&nbsp;{{#str}}update, core{{/str}}
                                        </a>
                                    {{/isapp}}
                                {{/isupdatable}}
                                <button type="button" class="btn btn-outline-secondary" data-action="delete-library-item" data-library-action="{{uninstallaction}}" data-reportid="{{itemid}}" data-title="{{#str}}uninstall, local_la{{/str}}" data-message="{{uninstallmessage}}" data-confirm-button-label="{{#str}}uninstall, local_la{{/str}}">
                                    <i class="fa-solid fa-trash"></i>&nbsp;&nbsp;{{#str}}uninstall, local_la{{/str}}
                                </button>
                            {{/isadded}}
                        </div>
                        {{#has_installs}}
                            <span class="text-nowrap ms-auto"><strong>{{install_count}}</strong> {{install_label}}</span>
                        {{/has_installs}}
                    </div>
                </div>
            </div>
        </div>
    {{/items}}
    {{^items}}
        <div class="col-12">
            <div class="text-muted text-center py-4">{{#str}}notfound, local_la{{/str}}</div>
        </div>
    {{/items}}
</div>
