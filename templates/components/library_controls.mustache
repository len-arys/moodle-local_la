{{!
    @template local_la/components/library_controls

    Renders search, filtering, and sorting controls for library pages.

    Classes required for JS:
    * .btn - JavaScript selector hook.
    * .dropdown - JavaScript selector hook.
    * .dropdown-menu - JavaScript selector hook.
    * .form-control - JavaScript selector hook.

    Data attributes required for JS:
    * data-bs-toggle="dropdown" - JavaScript data or selector hook.

    Context variables required for this template:
    * hasfilter - array|bool: Section data or visibility flag for hasfilter.
    * filterid - int: Numeric value for filterid.
    * currentfilter - string: Text for currentfilter.
    * filteroptions - array|bool: Section data or visibility flag for filteroptions.
    * active - array|bool: Section data or visibility flag for active.
    * url - string: URL for url.
    * name - string: Text for name.
    * hassecondaryfilter - array|bool: Section data or visibility flag for hassecondaryfilter.
    * secondaryfilterid - int: Numeric value for secondaryfilterid.
    * currentsecondaryfilter - string: Text for currentsecondaryfilter.
    * secondaryfilteroptions - array|bool: Section data or visibility flag for secondaryfilteroptions.
    * hassearch - array|bool: Section data or visibility flag for hassearch.
    * searchaction - string: URL for searchaction.
    * hiddenfields - array: List of entries for hiddenfields.
    * value - string: Text for value.
    * searchid - int: Numeric value for searchid.
    * searchname - string: Text for searchname.
    * searchvalue - string: Text for searchvalue.
    * hassort - array|bool: Section data or visibility flag for hassort.
    * sortid - int: Numeric value for sortid.
    * currentsort - string: Text for currentsort.
    * sortoptions - array|bool: Section data or visibility flag for sortoptions.
    * hasdirection - array|bool: Section data or visibility flag for hasdirection.
    * directionid - int: Numeric value for directionid.
    * currentdirection - string: Text for currentdirection.
    * directionoptions - array|bool: Section data or visibility flag for directionoptions.

    Example context (json):
    {
        "hassearch": true,
        "searchaction": "#",
        "searchname": "search",
        "searchvalue": "",
        "hassort": true,
        "sortoptions": [
            {
                "value": "name",
                "name": "Name",
                "active": true
            }
        ]
    }
}}
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    {{#hasfilter}}
        <div class="dropdown">
            <button id="{{filterid}}" type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {{currentfilter}}
            </button>
            <ul class="dropdown-menu" aria-labelledby="{{filterid}}">
                {{#filteroptions}}
                    <li><a class="dropdown-item {{#active}}active{{/active}}" href="{{url}}">{{name}}</a></li>
                {{/filteroptions}}
            </ul>
        </div>
    {{/hasfilter}}

    {{#hassecondaryfilter}}
        <div class="dropdown">
            <button id="{{secondaryfilterid}}" type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {{currentsecondaryfilter}}
            </button>
            <ul class="dropdown-menu" aria-labelledby="{{secondaryfilterid}}">
                {{#secondaryfilteroptions}}
                    <li><a class="dropdown-item {{#active}}active{{/active}}" href="{{url}}">{{name}}</a></li>
                {{/secondaryfilteroptions}}
            </ul>
        </div>
    {{/hassecondaryfilter}}

    {{#hassearch}}
        <div class="flex-grow-1">
            <form class="m-0" role="search" method="get" action="{{searchaction}}">
                {{#hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <label class="visually-hidden" for="{{searchid}}">{{#str}}search, core{{/str}}</label>
                <input id="{{searchid}}" name="{{searchname}}" type="text" class="form-control" value="{{searchvalue}}" placeholder="{{#str}}search, core{{/str}}">
            </form>
        </div>
    {{/hassearch}}

    {{#hassort}}
        <div class="dropdown">
            <button id="{{sortid}}" type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {{currentsort}}
            </button>
            <ul class="dropdown-menu" aria-labelledby="{{sortid}}">
                {{#sortoptions}}
                    <li><a class="dropdown-item {{#active}}active{{/active}}" href="{{url}}">{{name}}</a></li>
                {{/sortoptions}}
            </ul>
        </div>
    {{/hassort}}

    {{#hasdirection}}
        <div class="dropdown">
            <button id="{{directionid}}" type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                {{currentdirection}}
            </button>
            <ul class="dropdown-menu" aria-labelledby="{{directionid}}">
                {{#directionoptions}}
                    <li><a class="dropdown-item {{#active}}active{{/active}}" href="{{url}}">{{name}}</a></li>
                {{/directionoptions}}
            </ul>
        </div>
    {{/hasdirection}}
</div>
