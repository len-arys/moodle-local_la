{{!
    @template local_la/components/autocomplete/selection_items

    Renders selected report user autocomplete items.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-value - JavaScript data or selector hook.

    Context variables required for this template:
    * items - array: List of entries for items.
    * value - string: Text for value.
    * label - string: Text for label.

    Example context (json):
    {
        "items": [
            {
                "value": "2",
                "label": "Richard Burke"
            }
        ]
    }
}}
{{#items}}
    <span data-value="{{value}}" class="badge bg-secondary text-dark la-report-autocomplete-selection-item">
        <span aria-hidden="true">× </span>{{{label}}}
    </span>
{{/items}}
