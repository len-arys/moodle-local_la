{{!
    @template local_la/modal/calendar/years

    Renders the multi-year calendar grid.

    Classes required for JS:
    * .btn - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="calendar-load" - JavaScript data or selector hook.
    * data-month - JavaScript data or selector hook.
    * data-view - JavaScript data or selector hook.
    * data-year - JavaScript data or selector hook.

    Context variables required for this template:
    * years - array: List of entries for years.
    * isselected - array|bool: Section data or visibility flag for isselected.
    * isoutside - array|bool: Section data or visibility flag for isoutside.
    * hasactivity - array|bool: Section data or visibility flag for hasactivity.
    * level - string: Text for level.
    * targetview - string: Text for targetview.
    * targetyear - int: Numeric value for targetyear.
    * targetmonth - int: Numeric value for targetmonth.
    * title - string: Text for title.
    * label - string: Text for label.
    * value - string: Text for value.

    Example context (json):
    {
        "years": [
            {
                "label": "2026",
                "value": "120h",
                "targetyear": 2026,
                "hasactivity": true
            }
        ]
    }
}}
<div class="la-calendar-selection-grid">
    {{#years}}
    <button
        type="button"
        class="btn la-calendar-selection la-calendar-cell{{#isselected}} is-selected{{/isselected}}{{#isoutside}} is-outside{{/isoutside}}{{#hasactivity}} la-calendar-level-{{level}}{{/hasactivity}}"
        data-action="calendar-load"
        data-view="{{targetview}}"
        data-year="{{targetyear}}"
        data-month="{{targetmonth}}"
        title="{{title}}"
    >
        <span class="la-calendar-cell-label">{{label}}</span>
        <span class="la-calendar-cell-value">{{value}}</span>
    </button>
    {{/years}}
</div>
