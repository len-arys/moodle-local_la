{{!
    @template local_la/modal/calendar/week

    Renders the calendar week grid.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * weekdays - array: List of entries for weekdays.
    * label - string: Text for label.
    * day - int: Numeric value for day.
    * hours - array: List of entries for hours.
    * cells - array: List of entries for cells.
    * hasactivity - array|bool: Section data or visibility flag for hasactivity.
    * level - string: Text for level.
    * title - string: Text for title.
    * value - string: Text for value.

    Example context (json):
    {
        "hours": [
            {
                "label": "09:00",
                "cells": [
                    {
                        "title": "Monday 09:00",
                        "value": "30m",
                        "hasactivity": true
                    }
                ]
            }
        ]
    }
}}
<div class="la-calendar-week-grid">
    <div class="la-calendar-week-row la-calendar-week-head">
        <div class="la-calendar-week-hour-label"></div>
        {{#weekdays}}
        <div class="la-calendar-week-column-head">
            <div class="la-calendar-weekday">{{label}} {{day}}</div>
        </div>
        {{/weekdays}}
    </div>

    {{#hours}}
    <div class="la-calendar-week-row">
        <div class="la-calendar-week-hour-label">{{label}}</div>
        {{#cells}}
        <div class="la-calendar-week-cell la-calendar-cell{{#hasactivity}} la-calendar-level-{{level}}{{/hasactivity}}" title="{{title}}">
            <div class="la-calendar-cell-value">{{value}}</div>
        </div>
        {{/cells}}
    </div>
    {{/hours}}
</div>
