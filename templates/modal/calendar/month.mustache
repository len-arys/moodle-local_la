{{!
    @template local_la/modal/calendar/month

    Renders the calendar month grid.

    Classes required for JS:
    * .btn - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="calendar-load" - JavaScript data or selector hook.
    * data-day - JavaScript data or selector hook.
    * data-month - JavaScript data or selector hook.
    * data-view - JavaScript data or selector hook.
    * data-year - JavaScript data or selector hook.

    Context variables required for this template:
    * weeks - array: List of entries for weeks.
    * days - array: List of entries for days.
    * isoutside - array|bool: Section data or visibility flag for isoutside.
    * hasactivity - array|bool: Section data or visibility flag for hasactivity.
    * level - string: Text for level.
    * targetview - string: Text for targetview.
    * targetyear - int: Numeric value for targetyear.
    * targetmonth - int: Numeric value for targetmonth.
    * targetday - int: Numeric value for targetday.
    * title - string: Text for title.
    * day - int: Numeric value for day.
    * value - string: Text for value.

    Example context (json):
    {
        "weeks": [
            {
                "days": [
                    {
                        "day": 1,
                        "title": "1 August 2026",
                        "value": "2h",
                        "hasactivity": true
                    }
                ]
            }
        ]
    }
}}
<div class="la-calendar-month-grid">
    {{#weeks}}
    <div class="la-calendar-row">
        {{#days}}
        <button
            type="button"
            class="btn la-calendar-day la-calendar-cell{{#isoutside}} la-calendar-day-outside{{/isoutside}}{{#hasactivity}} la-calendar-level-{{level}}{{/hasactivity}}"
            data-action="calendar-load"
            data-view="{{targetview}}"
            data-year="{{targetyear}}"
            data-month="{{targetmonth}}"
            data-day="{{targetday}}"
            title="{{title}}"
        >
            <span class="la-calendar-cell-label">{{day}}</span>
            <span class="la-calendar-cell-value">{{value}}</span>
        </button>
        {{/days}}
    </div>
    {{/weeks}}
</div>
