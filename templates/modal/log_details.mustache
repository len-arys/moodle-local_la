{{!
    @template local_la/modal/log_details

    Renders audit log detail values.

    Classes required for JS:
    * .row - JavaScript selector hook.

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * items - array: List of entries for items.
    * label - string: Text for label.
    * value - string: Text for value.
    * hasdetails - array|bool: Section data or visibility flag for hasdetails.
    * details - string: Text for details.
    * nodetails - string: Text for nodetails.

    Example context (json):
    {
        "hasdetails": true,
        "items": [
            {
                "label": "Report",
                "value": "Users tracking"
            }
        ]
    }
}}
<div class="la-log-details">
    <dl class="row mb-0">
        {{#items}}
            <dt class="col-sm-3 text-muted">{{label}}</dt>
            <dd class="col-sm-9">{{value}}</dd>
        {{/items}}
    </dl>
    <hr>
    <h6>{{#str}}details, core{{/str}}</h6>
    {{#hasdetails}}
        <pre class="bg-light border rounded p-3 mb-0 overflow-auto small"><code>{{details}}</code></pre>
    {{/hasdetails}}
    {{^hasdetails}}
        <p class="text-muted mb-0">{{nodetails}}</p>
    {{/hasdetails}}
</div>
