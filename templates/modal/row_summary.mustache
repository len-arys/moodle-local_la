{{!
    @template local_la/modal/row_summary

    Renders an AI-generated summary of selected report rows.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * countlabel - string: Text for countlabel.
    * summary - string: Text for summary.
    * metrics - array: List of entries for metrics.
    * label - string: Text for label.
    * value - string: Text for value.
    * detail - array|bool: Section data or visibility flag for detail.
    * focusitems - array|bool: Section data or visibility flag for focusitems.

    Example context (json):
    {
        "countlabel": "2 selected rows",
        "summary": "Selected users are active.",
        "metrics": [
            {
                "label": "Visits",
                "value": "24",
                "detail": "This week"
            }
        ],
        "focusitems": [
            "Review learning time."
        ]
    }
}}
<div class="la-ai-analysis">
    <section class="la-ai-analysis-hero">
        <div class="la-ai-analysis-eyebrow">{{#str}}selecteddatasummary, local_la{{/str}}</div>
        <h4 class="la-ai-analysis-title">{{countlabel}}</h4>
        <p class="la-ai-analysis-summary">{{summary}}</p>
    </section>

    <div class="la-ai-analysis-metrics">
        {{#metrics}}
            <article class="la-ai-analysis-metric">
                <div class="la-ai-analysis-metric-label">{{label}}</div>
                <div class="la-ai-analysis-metric-value">{{value}}</div>
                {{#detail}}
                    <div class="la-ai-analysis-metric-detail">{{detail}}</div>
                {{/detail}}
            </article>
        {{/metrics}}
    </div>

    <section class="la-ai-analysis-section">
        <h5>{{#str}}whattoreview, local_la{{/str}}</h5>
        <ul class="la-ai-analysis-list">
            {{#focusitems}}
                <li>{{.}}</li>
            {{/focusitems}}
        </ul>
    </section>
</div>
