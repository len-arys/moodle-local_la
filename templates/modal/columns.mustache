{{!
    @template local_la/modal/columns

    Renders the report column bank and search interface.

    Classes required for JS:
    * .btn - JavaScript selector hook.
    * .btn-primary - JavaScript selector hook.
    * .d-none - JavaScript selector hook.
    * .fa - JavaScript selector hook.
    * .form-control - JavaScript selector hook.
    * .la-modal-footer - JavaScript selector hook.
    * .modal-footer - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="builder-cancel" - JavaScript data or selector hook.
    * data-action="builder-save" - JavaScript data or selector hook.
    * data-action="builder-toggle-column" - JavaScript data or selector hook.
    * data-action="builder-toggle-comment" - JavaScript data or selector hook.
    * data-bs-target - JavaScript data or selector hook.
    * data-bs-toggle="collapse" - JavaScript data or selector hook.
    * data-entity-key - JavaScript data or selector hook.
    * data-field - JavaScript data or selector hook.
    * data-region="builder-comment" - JavaScript data or selector hook.
    * data-region="builder-item" - JavaScript data or selector hook.
    * data-region="builder-search" - JavaScript data or selector hook.
    * data-region="builder-section" - JavaScript data or selector hook.
    * data-region="builder-section-name" - JavaScript data or selector hook.
    * data-region="builder-settings" - JavaScript data or selector hook.
    * data-report-id - JavaScript data or selector hook.

    Context variables required for this template:
    * hassections - array|bool: Section data or visibility flag for hassections.
    * reportid - int: Numeric value for reportid.
    * sections - array: List of entries for sections.
    * id - int: Numeric value for id.
    * name - string: Text for name.
    * count - int: Numeric value for count.
    * fields - array: List of entries for fields.
    * active - array|bool: Section data or visibility flag for active.
    * entitykey - string: Text for entitykey.
    * fieldkey - string: Text for fieldkey.
    * columnkey - string: Text for columnkey.
    * label - string: Text for label.
    * comment - array|bool: Section data or visibility flag for comment.
    * placeholder - string: Text for placeholder.

    Example context (json):
    {
        "reportid": 1,
        "hassections": true,
        "sections": [
            {
                "name": "User",
                "fields": [
                    {
                        "label": "Email",
                        "fieldkey": "email",
                        "entitykey": "user"
                    }
                ]
            }
        ]
    }
}}
<div class="la-columns-modal">
    {{#hassections}}
        <div class="input-group mb-3">
            <input
                type="search"
                class="form-control rounded-start border-end-0"
                data-region="builder-search"
                placeholder="{{#str}}search, core{{/str}}"
                aria-label="{{#str}}search, core{{/str}}"
            >
            <span class="input-group-text ps-2 bg-white">
                <i class="fa fa-search" aria-hidden="true"></i>
            </span>
        </div>
        <div id="la-columns-accordion" data-report-id="{{reportid}}">
            {{#sections}}
                <div class="card mb-2" data-region="builder-section">
                    <div class="card-header p-0 border-0" id="{{id}}-heading">
                        <button
                            class="btn btn-link text-decoration-none text-reset d-flex align-items-center w-100 px-3 py-2 la-columns-section-toggle"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#{{id}}-body"
                            aria-expanded="false"
                            aria-controls="{{id}}-body"
                        >
                            <span data-region="builder-section-name">{{name}}</span>
                            <span class="badge bg-info ms-2">{{count}}</span>
                            <i class="fa fa-chevron-down ms-auto" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div
                        id="{{id}}-body"
                        class="collapse"
                        aria-labelledby="{{id}}-heading"
                    >
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush">
                                {{#fields}}
                                    <div class="list-group-item list-group-item-action bg-transparent px-0 py-0{{#active}} is-active{{/active}}" data-region="builder-item" data-entity-key="{{entitykey}}" data-field="{{fieldkey}}">
                                        <input type="hidden" name="columns[{{columnkey}}][entitykey]" value="{{entitykey}}">
                                        <input type="hidden" name="columns[{{columnkey}}][field]" value="{{fieldkey}}">
                                        <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="la-columns-status-dot rounded-circle bg-{{#active}}success{{/active}}{{^active}}secondary{{/active}} opacity-50 flex-shrink-0" aria-hidden="true"></span>
                                                    <div class="mb-0">{{label}}</div>
                                                    <span class="badge bg-light text-muted fw-normal">{{name}}</span>
                                                    {{#comment}}
                                                        <button
                                                            type="button"
                                                            class="btn btn-link btn-sm p-0 text-decoration-none"
                                                            data-action="builder-toggle-comment"
                                                            aria-expanded="false"
                                                            aria-label="{{#str}}showcomment, local_la{{/str}}"
                                                        ><i class="fa-solid fa-circle-question"></i></button>
                                                    {{/comment}}
                                                </div>
                                                {{#comment}}
                                                    <div class="la-columns-field-comment small text-muted mt-1 d-none" data-region="builder-comment">{{comment}}</div>
                                                {{/comment}}
                                            </div>
                                            <div class="d-flex align-items-center flex-shrink-0">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-reset" data-action="builder-toggle-column" aria-expanded="false">
                                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="border-top px-3 py-3 d-none text-bg-light" data-region="builder-settings">
                                            {{> local_la/components/column_form}}
                                        </div>
                                    </div>
                                {{/fields}}
                            </div>
                        </div>
                    </div>
                </div>
            {{/sections}}
        </div>
        <div class="modal-footer la-modal-footer">
            <button type="button" class="btn btn-link" data-action="builder-cancel">{{#str}}cancel, core{{/str}}</button>
            <button type="button" class="btn btn-primary" data-action="builder-save">{{#str}}save, core{{/str}}</button>
        </div>
    {{/hassections}}
    {{^hassections}}
        <div class="text-muted">{{placeholder}}</div>
    {{/hassections}}
</div>
