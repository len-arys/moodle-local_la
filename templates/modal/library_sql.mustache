{{!
    @template local_la/modal/library_sql

    Renders an installed report SQL definition and metadata.

    Classes required for JS:
    * .alert - JavaScript selector hook.
    * .btn - JavaScript selector hook.
    * .fa - JavaScript selector hook.
    * .show - JavaScript selector hook.
    * .table - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="toggle-sql-status" - JavaScript data or selector hook.
    * data-bs-placement="top" - JavaScript data or selector hook.
    * data-bs-toggle="collapse" - JavaScript data or selector hook.
    * data-bs-toggle="tooltip" - JavaScript data or selector hook.
    * data-initial-status - JavaScript data or selector hook.
    * data-region="sql-timeactivated" - JavaScript data or selector hook.
    * data-sql-name - JavaScript data or selector hook.

    Context variables required for this template:
    * report_fields - array|bool: Section data or visibility flag for report fields.
    * key - string: Text for key.
    * istags - array|bool: Section data or visibility flag for istags.
    * tags - array: List of entries for tags.
    * name - string: Text for name.
    * value - string: Text for value.
    * has_sql_snippets - array|bool: Section data or visibility flag for has sql snippets.
    * sql_snippets - array|bool: Section data or visibility flag for sql snippets.
    * version - string: Text for version.
    * timecreated - string: Text for timecreated.
    * timemodified - string: Text for timemodified.
    * status_checked - array|bool: Section data or visibility flag for status checked.
    * timeactivated - string: Text for timeactivated.
    * code - string: Text for code.
    * validation - array: List of entries for validation.
    * icon - string: Text for icon.
    * class - string: Text for class.
    * has_sql - array|bool: Section data or visibility flag for has sql.
    * sql - string: Text for sql.
    * has_columns - array|bool: Section data or visibility flag for has columns.
    * columns - array: List of entries for columns.
    * type - string: Text for type.
    * drilldown_is_badge - array|bool: Section data or visibility flag for drilldown is badge.
    * drilldown_class - string: Text for drilldown class.
    * drilldown_has_tooltip - array|bool: Section data or visibility flag for drilldown has tooltip.
    * drilldown_tooltip - string: Text for drilldown tooltip.
    * drilldown - string: Text for drilldown.
    * visible - bool: Whether visible is enabled.

    Example context (json):
    {
        "name": "Users tracking",
        "version": "1.0.0",
        "has_sql": true,
        "sql": "SELECT id FROM user",
        "has_columns": true,
        "columns": [
            {
                "name": "User ID",
                "key": "id",
                "visible": true
            }
        ]
    }
}}
<div class="mform">
    <fieldset class="clearfix fitem collapsible" id="la-library-report-details" name="reportdetails">
        <legend class="visually-hidden">{{#str}}reportdetails, local_la{{/str}}</legend>
        <div class="d-flex align-items-center mb-2">
            <div class="position-relative d-flex ftoggler align-items-center me-1">
                <a data-toggle="collapse" href="#la-library-report-details-container" role="button" aria-expanded="true" aria-controls="la-library-report-details-container" class="btn btn-icon me-3 icons-collapse-expand stretched-link fheader">
                    <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}"><i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i></span>
                    <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                    <span class="visually-hidden">{{#str}}reportdetails, local_la{{/str}}</span>
                </a>
                <h3 class="d-flex align-self-stretch align-items-center mb-0" aria-hidden="true">{{#str}}reportdetails, local_la{{/str}}</h3>
            </div>
        </div>
        <div id="la-library-report-details-container" class="fcontainer collapseable collapse show la-library-sql-section-content">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    {{#report_fields}}
                        <tr>
                            <th scope="row" class="text-nowrap"><code>{{key}}</code></th>
                            <td>
                                {{#istags}}
                                    {{#tags}}
                                        <span class="badge text-bg-secondary me-1">{{name}}</span>
                                    {{/tags}}
                                    {{^tags}}
                                        -
                                    {{/tags}}
                                {{/istags}}
                                {{^istags}}
                                    {{value}}
                                {{/istags}}
                            </td>
                        </tr>
                    {{/report_fields}}
                    </tbody>
                </table>
            </div>
        </div>
    </fieldset>

    {{#has_sql_snippets}}
        <fieldset class="clearfix fitem collapsible collapsed" id="la-library-sql-snippets" name="sqlsnippets">
            <legend class="visually-hidden">{{#str}}sql, local_la{{/str}}</legend>
            <div class="d-flex align-items-center mb-2">
                <div class="position-relative d-flex ftoggler align-items-center me-1">
                    <a data-toggle="collapse" href="#la-library-sql-snippets-container" role="button" aria-expanded="false" aria-controls="la-library-sql-snippets-container" class="btn btn-icon me-3 icons-collapse-expand stretched-link fheader collapsed">
                        <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}"><i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i></span>
                        <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                        <span class="visually-hidden">{{#str}}sql, local_la{{/str}}</span>
                    </a>
                    <h3 class="d-flex align-self-stretch align-items-center mb-0" aria-hidden="true">{{#str}}sql, local_la{{/str}}</h3>
                </div>
            </div>
            <div id="la-library-sql-snippets-container" class="fcontainer collapseable collapse la-library-sql-section-content">
                {{#sql_snippets}}
                    <div class="mb-4">
                        <div><span class="badge text-bg-info mb-2"><i class="fa-solid fa-code"></i> {{name}}</span></div>
                        <div class="table-responsive mb-2">
                            <table class="table align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>name</code></th>
                                        <td><code>{{name}}</code></td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>version</code></th>
                                        <td>{{version}}</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>timecreated</code></th>
                                        <td>{{timecreated}}</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>timemodified</code></th>
                                        <td>{{timemodified}}</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>status</code></th>
                                        <td>
                                            <input type="checkbox" class="form-check-input" data-action="toggle-sql-status" data-sql-name="{{name}}" data-initial-status="{{#status_checked}}1{{/status_checked}}{{^status_checked}}0{{/status_checked}}" {{#status_checked}}checked{{/status_checked}}>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>timeactivated</code></th>
                                        <td data-region="sql-timeactivated" data-sql-name="{{name}}">{{timeactivated}}</td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>code</code></th>
                                        <td><pre class="la-sql-preview mb-0"><code class="la-sql-preview-code">{{code}}</code></pre></td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap">{{#str}}validation, local_la{{/str}}</th>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                {{#validation}}
                                                    <span><i class="fa-solid {{icon}} {{class}} me-1" aria-hidden="true"></i>{{name}}</span>
                                                {{/validation}}
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                {{/sql_snippets}}

                <a href="#la-library-full-query" class="d-inline-flex align-items-center gap-1" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="la-library-full-query">
                    {{#str}}showfullquery, local_la{{/str}}
                    <i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i>
                </a>
                <div id="la-library-full-query" class="collapse mt-3">
                    {{#has_sql}}
                        <pre class="la-sql-preview mb-0"><code class="la-sql-preview-code">{{sql}}</code></pre>
                    {{/has_sql}}
                    {{^has_sql}}
                        <div class="alert alert-warning mb-0">{{#str}}fullqueryunavailable, local_la{{/str}}</div>
                    {{/has_sql}}
                </div>
            </div>
        </fieldset>
    {{/has_sql_snippets}}

    {{#has_columns}}
        <fieldset class="clearfix fitem collapsible collapsed" id="la-library-sql-columns" name="columns">
            <legend class="visually-hidden">{{#str}}columns, local_la{{/str}}</legend>
            <div class="d-flex align-items-center mb-2">
                <div class="position-relative d-flex ftoggler align-items-center me-1">
                    <a data-toggle="collapse" href="#la-library-sql-columns-container" role="button" aria-expanded="false" aria-controls="la-library-sql-columns-container" class="btn btn-icon me-3 icons-collapse-expand stretched-link fheader collapsed">
                        <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}"><i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i></span>
                        <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                        <span class="visually-hidden">{{#str}}columns, local_la{{/str}}</span>
                    </a>
                    <h3 class="d-flex align-self-stretch align-items-center mb-0" aria-hidden="true">{{#str}}columns, local_la{{/str}}</h3>
                </div>
            </div>
            <div id="la-library-sql-columns-container" class="fcontainer collapseable collapse la-library-sql-section-content">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                        <tr>
                            <th scope="col">{{#str}}key, local_la{{/str}}</th>
                            <th scope="col">{{#str}}name, core{{/str}}</th>
                            <th scope="col">{{#str}}type, local_la{{/str}}</th>
                            <th scope="col">{{#str}}drilldown, local_la{{/str}}</th>
                            <th scope="col">{{#str}}visible, core{{/str}}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#columns}}
                            <tr>
                                <td><code>{{key}}</code></td>
                                <td>{{name}}</td>
                                <td>{{type}}</td>
                                <td>
                                    {{#drilldown_is_badge}}
                                        <span class="badge {{drilldown_class}}"{{#drilldown_has_tooltip}} data-toggle="tooltip" data-placement="top" title="{{drilldown_tooltip}}"{{/drilldown_has_tooltip}}>{{drilldown}}</span>
                                    {{/drilldown_is_badge}}
                                    {{^drilldown_is_badge}}
                                        <code>{{drilldown}}</code>
                                    {{/drilldown_is_badge}}
                                </td>
                                <td>{{visible}}</td>
                            </tr>
                        {{/columns}}
                        </tbody>
                    </table>
                </div>
            </div>
        </fieldset>
    {{/has_columns}}
</div>
