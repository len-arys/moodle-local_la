{{!
    @template local_la/modal/row_patterns

    Renders detected patterns and recommended actions for selected report rows.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * signals - array: List of entries for signals.
    * tone - string: Text for tone.
    * title - string: Text for title.
    * body - string: Text for body.
    * actions - array: List of entries for actions.

    Example context (json):
    {
        "signals": [
            {
                "tone": "info",
                "title": "Activity increased",
                "body": "Visits increased this week."
            }
        ],
        "actions": [
            "Review course activity."
        ]
    }
}}
<div class="la-ai-analysis">
    <section class="la-ai-analysis-hero">
        <div class="la-ai-analysis-eyebrow">{{#str}}patternscan, local_la{{/str}}</div>
        <h4 class="la-ai-analysis-title">{{#str}}whatstandsout, local_la{{/str}}</h4>
        <p class="la-ai-analysis-summary">{{#str}}patternscannote, local_la{{/str}}</p>
    </section>

    <div class="la-ai-pattern-grid">
        {{#signals}}
            <article class="la-ai-pattern-card la-ai-pattern-card-{{tone}}">
                <div class="la-ai-pattern-title">{{title}}</div>
                <p>{{body}}</p>
            </article>
        {{/signals}}
    </div>

    <section class="la-ai-analysis-section">
        <h5>{{#str}}recommendednextsteps, local_la{{/str}}</h5>
        <ol class="la-ai-analysis-list">
            {{#actions}}
                <li>{{.}}</li>
            {{/actions}}
        </ol>
    </section>
</div>
