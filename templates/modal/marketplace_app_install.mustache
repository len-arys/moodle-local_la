{{!
    @template local_la/modal/marketplace_app_install

    Renders the marketplace app installation review.

    Classes required for JS:
    * .btn - JavaScript selector hook.
    * .fa - JavaScript selector hook.
    * .form-check - JavaScript selector hook.
    * .show - JavaScript selector hook.
    * .table - JavaScript selector hook.

    Data attributes required for JS:
    * data-action="accept-marketplace-sql" - JavaScript data or selector hook.
    * data-bs-toggle="collapse" - JavaScript data or selector hook.

    Context variables required for this template:
    * fields - array: List of entries for fields.
    * key - string: Text for key.
    * istags - array|bool: Section data or visibility flag for istags.
    * tags - array: List of entries for tags.
    * name - string: Text for name.
    * value - string: Text for value.
    * widgets - array: List of entries for widgets.
    * title - string: Text for title.
    * type - string: Text for type.
    * snippets - array: List of entries for snippets.
    * code - string: Text for code.
    * validation - array: List of entries for validation.
    * icon - string: Text for icon.
    * class - string: Text for class.

    Example context (json):
    {
        "title": "Install app",
        "name": "Learning overview",
        "fields": [
            {
                "name": "Version",
                "value": "1.0.0"
            }
        ],
        "validation": [
            {
                "value": "Ready"
            }
        ]
    }
}}
<div class="mform">
    <fieldset class="clearfix fitem collapsible" id="la-marketplace-install-app-details" name="appdetails">
        <legend class="visually-hidden">{{#str}}appdetails, local_la{{/str}}</legend>
        <div class="d-flex align-items-center mb-2">
            <div class="position-relative d-flex ftoggler align-items-center me-1">
                <a data-toggle="collapse" href="#la-marketplace-install-app-details-container" role="button" aria-expanded="true" aria-controls="la-marketplace-install-app-details-container" class="btn btn-icon me-3 icons-collapse-expand stretched-link fheader">
                    <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}"><i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i></span>
                    <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                    <span class="visually-hidden">{{#str}}appdetails, local_la{{/str}}</span>
                </a>
                <h3 class="d-flex align-self-stretch align-items-center mb-0" aria-hidden="true">{{#str}}appdetails, local_la{{/str}}</h3>
            </div>
        </div>
        <div id="la-marketplace-install-app-details-container" class="fcontainer collapseable collapse show la-library-sql-section-content">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <tbody>
                    {{#fields}}
                        <tr>
                            <th scope="row" class="text-nowrap"><code>{{key}}</code></th>
                            <td>
                                {{#istags}}
                                    {{#tags}}
                                        <span class="badge text-bg-secondary me-1">{{name}}</span>
                                    {{/tags}}
                                    {{^tags}}
                                        {{value}}
                                    {{/tags}}
                                {{/istags}}
                                {{^istags}}
                                    {{value}}
                                {{/istags}}
                            </td>
                        </tr>
                    {{/fields}}
                    </tbody>
                </table>
            </div>
        </div>
    </fieldset>

    <fieldset class="clearfix fitem collapsible collapsed" id="la-marketplace-install-app-widgets" name="widgets">
        <legend class="visually-hidden">{{#str}}widgets, local_la{{/str}}</legend>
        <div class="d-flex align-items-center mb-2">
            <div class="position-relative d-flex ftoggler align-items-center me-1">
                <a data-toggle="collapse" href="#la-marketplace-install-app-widgets-container" role="button" aria-expanded="false" aria-controls="la-marketplace-install-app-widgets-container" class="btn btn-icon me-3 icons-collapse-expand stretched-link fheader collapsed">
                    <span class="expanded-icon icon-no-margin p-2" title="{{#str}}collapse, core{{/str}}"><i class="icon fa fa-chevron-down fa-fw" aria-hidden="true"></i></span>
                    <span class="collapsed-icon icon-no-margin p-2" title="{{#str}}expand, core{{/str}}"><i class="icon fa fa-chevron-right fa-fw" aria-hidden="true"></i></span>
                    <span class="visually-hidden">{{#str}}widgets, local_la{{/str}}</span>
                </a>
                <h3 class="d-flex align-self-stretch align-items-center mb-0" aria-hidden="true">{{#str}}widgets, local_la{{/str}}</h3>
            </div>
        </div>
        <div id="la-marketplace-install-app-widgets-container" class="fcontainer collapseable collapse la-library-sql-section-content">
            {{#widgets}}
                <div class="mb-4">
                    <div><span class="badge text-bg-info mb-2"><i class="fa-solid fa-chart-column"></i> {{title}}</span></div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-nowrap"><code>key</code></th>
                                    <td><code>{{key}}</code></td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-nowrap"><code>type</code></th>
                                    <td>{{type}}</td>
                                </tr>
                                {{#snippets}}
                                    <tr>
                                        <th scope="row" class="text-nowrap"><code>{{name}}</code></th>
                                        <td><pre class="la-sql-preview mb-0"><code class="la-sql-preview-code">{{code}}</code></pre></td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap">{{#str}}validation, local_la{{/str}}</th>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                {{#validation}}
                                                    <span><i class="fa-solid {{icon}} {{class}} me-1" aria-hidden="true"></i>{{name}}</span>
                                                {{/validation}}
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row" class="text-nowrap">{{#str}}reviewsqlsnippet, local_la{{/str}}</th>
                                        <td>
                                            <label class="form-check mb-0">
                                                <input type="checkbox" class="form-check-input" data-action="accept-marketplace-sql">
                                                <span class="visually-hidden">{{#str}}reviewsqlsnippet, local_la{{/str}}</span>
                                            </label>
                                        </td>
                                    </tr>
                                {{/snippets}}
                            </tbody>
                        </table>
                    </div>
                </div>
            {{/widgets}}
        </div>
    </fieldset>
</div>
